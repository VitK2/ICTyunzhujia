# Copy this file to .env.local. Never put API keys in frontend/VITE_ variables.
# demo: fixed tool planner, no model calls. cloud: actual Function Calling loop.
AGENT_MODE=demo
AGENT_PROVIDER=Huawei Cloud MaaS
# Paste the complete HTTPS chat/completions URL from your service console.
# China MaaS V2 example: https://api.modelarts-maas.com/v2/chat/completions
AGENT_API_URL=
# Choose a model you have enabled that supports Function Calling.
AGENT_MODEL=
AGENT_API_KEY=
